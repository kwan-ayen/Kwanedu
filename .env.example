# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Required only for first-run administrator password setup.
# Generate a private random value (for example: openssl rand -hex 32) and keep it secret.
ADMIN_SETUP_KEY=""

# Optional API origin. Leave empty when the frontend and API are deployed together on Vercel.
VITE_API_BASE_URL=""

# Required for Vercel serverless state storage. Provision a Postgres database from the Vercel Marketplace.
DATABASE_URL=""

# Required in production. Generate a stable random secret (for example: openssl rand -hex 32).
SESSION_SECRET=""

# Create separate Vercel Blob stores: a private store for resource files and a public store for CMS images.
BLOB_PRIVATE_READ_WRITE_TOKEN=""
BLOB_PUBLIC_READ_WRITE_TOKEN=""

# Set to true in Vercel so resource and CMS files upload directly from the browser to Blob.
VITE_BLOB_CLIENT_UPLOADS="false"

# Public Supabase client configuration. Vite exposes NEXT_PUBLIC_ variables in the browser.
NEXT_PUBLIC_SUPABASE_URL="https://oczibxohijjbddaffmwp.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_VIvDbEdYid7vRsA6JfuM6g_4t_H6kIW"

# Server-side Supabase configuration. Keep SUPABASE_SECRET_KEY out of source control and client bundles.
SUPABASE_URL="https://oczibxohijjbddaffmwp.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_VIvDbEdYid7vRsA6JfuM6g_4t_H6kIW"
SUPABASE_SECRET_KEY=""
SUPABASE_JWKS_URL="https://oczibxohijjbddaffmwp.supabase.co/auth/v1/.well-known/jwks.json"

# Optional comma-separated browser origins for a separately hosted API.
CORS_ORIGINS=""
